{
  "manifest_version": 3,
  "name": "passless",
  "version": "1.0.0",
  "description": "Signs in with the passkeys of your Passless store (password-store or passage) through the passless native messaging host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@passless.rs",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://*.localhost/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://*.localhost/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://*.localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
