{
  "manifest_version": 3,
  "name": "passless",
  "version": "1.0.0",
  "description": "Signs in with the passkeys of your Passless store (password-store or passage) through the passless native messaging host.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
